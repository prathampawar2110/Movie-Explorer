const API_KEY = "a4914b67";
const BASE_URL = "https://www.omdbapi.com/";
let movies = [ ];

let favorites = JSON.parse(localStorage.getItem("favorites")) || [];

async function fetchMovies(searchText) {

    const response = await fetch(
        `${BASE_URL}?apikey=${API_KEY}&s=${encodeURIComponent(searchText)}`
        // `${BASE_URL}?apikey=${API_KEY}&i=${movie.imdbID}&plot=full`
    );

    const data = await response.json();

    if (data.Response === "False") {
        return [];
    }
    return data.Search || [];
};

async function showDetails(id) {

    try{
        const response = await fetch(
        `${BASE_URL}?apikey=${API_KEY}&i=${id}&plot=short`
        );
        
        const movie = await response.json();

        if (movie.Response === "False") {
            alert("Movie Not Found");
        return;}

        // alert(movie.Plot); alert(movie.Country)
        alert(movie.Plot + "\n\nCountry: " + movie.Country) 

    }catch (error) {
        console.log(error)
        alert("something went wrong")
    } 
}

