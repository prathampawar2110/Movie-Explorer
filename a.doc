//----------------------------------------------------------------------------------------------------------------------------------------------------------------------

async function loadRandomMovies() {

    const randomSearchTerms = [
        "action",
        "comedy",
        "drama",
        "adventure",
        "marvel",
        "sci-fi",
        "horror"
    ];

    const randomTerm =
    randomSearchTerms[
        Math.floor(
            Math.random() * randomSearchTerms.length
        )
    ];

    const moviesFromAPI =
    await fetchMovies(randomTerm);

    movies = moviesFromAPI.map(movie => ({
        id: movie.imdbID,
        title: movie.Title,
        year: movie.Year,
        genre: movie.Genre,
        subtitle: movie.Runtime,
        description: movie.Plot,
        image: movie.Poster,
        country: movie.Country
    }));

    renderMovies(movies);
}

//----------------------------------------------------------------------------------------------------------------------------------------------------------------------

async function searchMovies() {

    const searchText = document.getElementById("searchText").value.trim();

       if (searchText === "") {
        loadRandomMovies();
        return;
    }

    const moviesFromAPI = await fetchMovies(searchText);

    movies = moviesFromAPI.map(movie=> ({
        id: movie.imdbID,
        title: movie.Title,
        year: movie.Year,
        genre: movie.Genre,
        subtitle: movie.Runtime,
        description: movie.Plot,
        image: movie.Poster,
        country: movie.Country
    }
));
renderMovies(movies);
};

//-----------------------------------------------------------------------------------------------------------------------------------------------------------------

function renderMovies(movieArray){                                                              //here we create function 'renderMovies' which accept one parameter 'movieArray'. this function take movie from  array & display it.

    const movieList = document.getElementById("movieList");                           //'getElementById' is a DOM method select and return element whose property is 'ID'

    movieList.innerHTML = "";                                                                           // if we don't use this line then we will get movie again and again repeatedly. Clears all existing content from movieList by setting its HTML content to an empty string

    if(!movieArray || movieArray.length === 0){                                                     
    movieList.innerHTML = "<h3>No movies found</h3>";                                // if yes display this message
    return;                                                                                                             // stop execution of rest of function
    }

    movieArray.forEach(movieFromDB => {
        
        const isFavorite = favorites.some(
        fav => fav.id === movieFromDB.id
        );

        movieList.innerHTML += `

        <div class="card">
            <img src="${movieFromDB.image}" alt="${movieFromDB.title}">
            <h3>${movieFromDB.title}</h3>
            <p>${movieFromDB.year}</p>
            
            <button onclick="showDetails('${movieFromDB.id}')">
                View Details
            </button>
            
            <button 
                onclick="addToFavorites('${movieFromDB.id}')"
                ${isFavorite ? "disabled" : ""}
            >
                ${isFavorite ? "Added to Favorites" : "Add to Favorite"}
            </button>
        
        </div>
        `;
    });
}

//-----------------------------------------------------------------------------------------------------------------------------------------

function addToFavorites(id) {

    const movieToAdd =
    movies.find(movie => movie.id === id);

    if (!movieToAdd) return;

    const alreadyExists = favorites.some(
        fav => fav.id === id
    );

    if (alreadyExists) {
        alert("Movie already in favorites!");
        return;
    }

    favorites.push(movieToAdd);

    localStorage.setItem(
        "favorites",
        JSON.stringify(favorites)
    );

    renderMovies(movies);
    renderFavorites();
    updateFavoritesCount();
}

//----------------------------------------------------------------------------------

function renderFavorites() {

    const favoriteList =
    document.getElementById("favoriteList");

    favoriteList.innerHTML = "";

    favorites.forEach(movie => {

        favoriteList.innerHTML += `
        
        <div>
            ${movie.title}

            <button onclick="removeFromFavorite('${movie.id}')">
                Remove
            </button>

            <br><br>
        </div>
        `;
    });
}

renderFavorites();

//------------------------------------------------------------------------------------

function removeFromFavorite(id) {

    favorites = favorites.filter(
        movie => movie.id !== id
    );

    localStorage.setItem("favorites",JSON.stringify(favorites));

    renderFavorites();
    renderMovies(movies);
    updateFavoritesCount();
}

//-------------------------------------------------------------------------------------

function updateFavoritesCount() {

    const favoritesTitle =
    document.getElementById("favoritesTitle");

    if (favorites.length === 0) {

        favoritesTitle.textContent =
        "No Favorites Yet";

    } else {

        favoritesTitle.textContent =
        `Favorites (${favorites.length})`;

    }
}

//------------------------------------------------------------------------------------------

document.addEventListener(
    "DOMContentLoaded",
    () => {
        loadRandomMovies();
        renderFavorites();
        updateFavoritesCount();
    }
);

const searchInput =
document.getElementById("searchText");

searchInput.addEventListener(
    "input",
    searchMovies
);